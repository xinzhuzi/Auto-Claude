#!/bin/bash
#
# Git Pre-Commit Hook - Mass Deletion Protection
# ===============================================
#
# This hook prevents accidental mass deletions caused by git index corruption.
# It checks if more than 50% of tracked files are being deleted and blocks the commit.
#
# Installation:
#   cp hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Get staged deletions count
deleted_count=$(git diff --cached --name-only --diff-filter=D 2>/dev/null | wc -l | tr -d ' ')

# Get total tracked files count
total_files=$(git ls-files 2>/dev/null | wc -l | tr -d ' ')

# Skip check if no files tracked
if [ "$total_files" -eq 0 ]; then
    exit 0
fi

# Calculate deletion percentage
if [ "$total_files" -gt 0 ]; then
    deletion_percentage=$((deleted_count * 100 / total_files))
else
    deletion_percentage=0
fi

# Threshold: 50% of files
threshold=50

# Check if deletion exceeds threshold
if [ "$total_files" -gt 100 ] && [ "$deletion_percentage" -gt "$threshold" ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}  ⚠️  COMMIT BLOCKED: Mass Deletion Detected${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${YELLOW}Deletion Statistics:${NC}"
    echo -e "  Files to be deleted: ${RED}$deleted_count${NC}"
    echo -e "  Total tracked files: $total_files"
    echo -e "  Deletion percentage: ${RED}${deletion_percentage}%${NC}"
    echo ""
    echo -e "${YELLOW}This may indicate git index corruption!${NC}"
    echo ""
    echo -e "${GREEN}Recommended Actions:${NC}"
    echo ""
    echo "  1. Check git status:"
    echo "     ${GREEN}git status${NC}"
    echo ""
    echo "  2. Check index health:"
    echo "     ${GREEN}git fsck${NC}"
    echo ""
    echo "  3. If index is corrupted, rebuild it safely:"
    echo "     ${GREEN}git read-tree HEAD${NC}"
    echo ""
    echo "  4. DO NOT use: ${RED}rm -f .git/index${NC} (This causes data loss!)"
    echo ""
    echo -e "${YELLOW}If this deletion is intentional:${NC}"
    echo "  Commit manually with --no-verify flag:"
    echo "  ${GREEN}git commit -m 'your message' --no-verify${NC}"
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

# Check for git index lock
if [ -f .git/index.lock ]; then
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}  ⚠️  WARNING: Git index lock file exists${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "This may indicate a stale lock from a previous operation."
    echo ""
    echo "To remove the lock:"
    echo "  ${GREEN}rm -f .git/index.lock${NC}"
    echo ""
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

# All checks passed
exit 0
